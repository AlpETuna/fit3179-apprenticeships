{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "height": 335,
  "data": {
    "url": "data/states.json"
  },
  "params": [
    {
      "name": "focusState",
      "value": "All"
    }
  ],
  "description": "Equal-size tile cartogram. Tile positions preserve broad geography, not distance or land area; colour shows 2024\u20132025 change in active contracts.",
  "encoding": {
    "x": {
      "field": "Column",
      "type": "ordinal",
      "axis": null,
      "scale": {
        "domain": [
          1,
          2,
          3,
          4
        ],
        "paddingInner": 0.07
      }
    },
    "y": {
      "field": "Row",
      "type": "ordinal",
      "axis": null,
      "scale": {
        "domain": [
          1,
          2,
          3,
          4
        ],
        "paddingInner": 0.07
      }
    },
    "tooltip": [
      {
        "field": "State"
      },
      {
        "field": "Change",
        "type": "quantitative",
        "format": ".1f",
        "title": "2024\u20132025 change (%)"
      },
      {
        "field": "Previous",
        "type": "quantitative",
        "format": ",",
        "title": "2024 contracts"
      },
      {
        "field": "Contracts",
        "type": "quantitative",
        "format": ",",
        "title": "2025 contracts"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "cornerRadius": 3
      },
      "encoding": {
        "color": {
          "field": "Change",
          "type": "quantitative",
          "scale": {
            "domain": [
              -20,
              0
            ],
            "range": [
              "#9a381a",
              "#fbe7db"
            ]
          },
          "legend": {
            "title": "Change in active contracts (%)",
            "orient": "bottom",
            "format": ".0f",
            "gradientLength": 220
          }
        },
        "stroke": {
          "condition": {
            "test": "datum.State === focusState",
            "value": "#132a40"
          },
          "value": "white"
        },
        "strokeWidth": {
          "condition": {
            "test": "datum.State === focusState",
            "value": 3
          },
          "value": 0
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": -10,
        "fontWeight": 700,
        "fontSize": 16
      },
      "encoding": {
        "text": {
          "field": "Short"
        },
        "color": {
          "condition": {
            "test": "datum.Change < -10",
            "value": "white"
          },
          "value": "#132a40"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": 13,
        "fontSize": 16
      },
      "encoding": {
        "text": {
          "field": "Change",
          "format": ".1f"
        },
        "color": {
          "condition": {
            "test": "datum.Change < -10",
            "value": "white"
          },
          "value": "#132a40"
        }
      }
    }
  ]
}
