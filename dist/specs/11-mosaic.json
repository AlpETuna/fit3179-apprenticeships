{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "height": 335,
  "data": {
    "url": "data/employment-pattern.json"
  },
  "description": "Mosaic chart: column width represents each trade group\u2019s share of trade-classified active contracts; segment height represents the published full-time/part-time percentage within that group. Percentages rounded by NCVER.",
  "transform": [
    {
      "calculate": "datum.Group === 'Trade' ? 0 : 208950 / (208950 + 73475)",
      "as": "x0"
    },
    {
      "calculate": "datum.Group === 'Trade' ? 208950 / (208950 + 73475) : 1",
      "as": "x1"
    },
    {
      "calculate": "datum.Arrangement === 'Full-time' ? 0 : (datum.Group === 'Trade' ? .92 : .557)",
      "as": "y0"
    },
    {
      "calculate": "datum.Arrangement === 'Full-time' ? datum.Percent/100 : 1",
      "as": "y1"
    },
    {
      "calculate": "(datum.x0+datum.x1)/2",
      "as": "xm"
    },
    {
      "calculate": "(datum.y0+datum.y1)/2",
      "as": "ym"
    },
    {
      "calculate": "datum.Arrangement + ' ' + format(datum.Percent, '.1f') + '%'",
      "as": "Label"
    }
  ],
  "encoding": {
    "tooltip": [
      {
        "field": "Group"
      },
      {
        "field": "Arrangement"
      },
      {
        "field": "Percent",
        "type": "quantitative",
        "format": ".1f",
        "title": "Within-group share (%)"
      },
      {
        "field": "Contracts",
        "type": "quantitative",
        "format": ",",
        "title": "All contracts in group"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 4
      },
      "encoding": {
        "x": {
          "field": "x0",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              1
            ]
          },
          "axis": null
        },
        "x2": {
          "field": "x1"
        },
        "y": {
          "field": "y1",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              1
            ]
          },
          "axis": null
        },
        "y2": {
          "field": "y0"
        },
        "color": {
          "field": "Arrangement",
          "type": "nominal",
          "scale": {
            "domain": [
              "Full-time",
              "Part-time"
            ],
            "range": [
              "#176b91",
              "#c45222"
            ]
          },
          "legend": {
            "title": null,
            "symbolType": "square"
          }
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 14,
        "fontWeight": 600,
        "color": "white"
      },
      "encoding": {
        "x": {
          "field": "xm",
          "type": "quantitative"
        },
        "y": {
          "field": "ym",
          "type": "quantitative"
        },
        "text": {
          "field": "Label"
        }
      }
    }
  ]
}
